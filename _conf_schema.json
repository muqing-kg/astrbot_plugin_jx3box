{
  "client": {
    "description": "游戏客户端",
    "type": "string",
    "default": "std",
    "hint": "通常填 std"
  },
  "choice_ttl_seconds": {
    "description": "连续选择有效时间（秒）",
    "type": "int",
    "default": 120,
    "hint": "发送候选列表后，直接回复数字或换页的有效时间"
  },
  "horse": {
    "description": "赤兔抓马提醒",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用赤兔提醒",
        "type": "bool",
        "default": true,
        "hint": "后台监测赤兔倒计时；区服与目标群改为命令订阅，无需在此配置"
      },
      "pre_alert_minutes": {
        "description": "刷新前提醒分钟数",
        "type": "int",
        "default": 10,
        "hint": "锁定 ETA 后，在 ETA 前多少分钟提醒"
      },
      "poll_idle_seconds": {
        "description": "未锁定时轮询间隔（秒）",
        "type": "int",
        "default": 300,
        "hint": "默认 5 分钟；无任何群订阅时也会按该间隔空转"
      },
      "calibrate_before_seconds": {
        "description": "到点前校准秒数",
        "type": "int",
        "default": 30,
        "hint": "ETA 前多少秒再请求一次校准"
      }
    }
  }
}
